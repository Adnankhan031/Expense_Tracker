{
  "name": "expense-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "update": "eas update --branch preview --message \"update\"",
    "update:prod": "eas update --branch production --message \"update\"",
    "build:ios": "eas build --profile preview --platform ios",
    "build:android": "eas build --profile preview --platform android",
    "build:all": "eas build --profile preview --platform all",
    "check:parser": "esbuild scripts/parser-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/parser-check.cjs --log-level=error && node node_modules/.cache/parser-check.cjs",
    "check": "npm run typecheck && npm run check:parser"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.15",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.25.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
